{
  "version": "2.0.0",
  "options": {
    "env": {
      "MSYS_NO_PATHCONV": "1",
      "CFG_USER": "storezhang",
      "CFG_REMOTE": "192.168.102.10",
      "CFG_IMAGE": "ccr.ccs.tencentyun.com/hetue/csr:latest",
      "CFG_CONTAINER": "${workspaceFolderBasename}-temp-container",
      "CFG_REPOSITORY": "${input:workdir}/${input:organization}/${input:project}/${input:module}",
      "CFG_FILEPATH": "/config/security.md",
      "CFG_LOCAL_FILENAME": "${input:module}.md"
    }
  },
  "tasks": [
    { // 创建连接
      "label": "docker-context-create",
      "type": "shell",
      "command": "docker",
      "args": [
        "context",
        "rm", "temp-remote-box", "-f"
      ],
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    { // 临时删除后的真正创建放在这里，确保干净
      "label": "docker-context-init",
      "type": "shell",
      "command": "docker",
      "args": [
        "context",
        "create", "temp-remote-box",
        "--docker", "host=ssh://$CFG_USER@$CFG_REMOTE"
      ],
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    { // 打包镜像
      "label": "docker-build-execute",
      "type": "shell",
      "command": "docker",
      "args": [
        "--context", "temp-remote-box",
        "build", "-t", "$CFG_IMAGE",
        "."
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    { // 专门用于前置强杀的子任务
      "label": "pre-cleanup-container",
      "type": "shell",
      "command": "docker",
      "args": [
        "--context", "temp-remote-box",
        "rm", "$CFG_CONTAINER", "-f"
      ],
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    { // 全自动合并公开和敏感文件
      "label": "merge-env-files",
      "type": "shell",
      "command": "cat .vscode/*.env > .vscode/combined.tmp.env",
      "presentation": {
          "reveal": "silent",
          "panel": "shared"
      }
    },
    { // 启动容器
      "label": "docker-container-create",
      "type": "shell",
      "command": "docker",
      "args": [
        "--context", "temp-remote-box",
        "run",
        // "--detach", // 正常使用
        "--tty", "--interactive", "--entrypoint", "/bin/sh", // 调试使用
        "--name", "$CFG_CONTAINER",
        "--volume", "$CFG_REPOSITORY:/config",
        "--env-file", ".vscode/combined.tmp.env",
        "$CFG_IMAGE"
      ],
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "panel": "shared",
        "focus": true
      }
    },
    { // 复制文件到本地
      "label": "docker-container-cp",
      "type": "shell",
      "command": "bash",
        "args": [
          "-c",
          "docker --context temp-remote-box logs -f $CFG_CONTAINER && docker --context temp-remote-box cp $CFG_CONTAINER:$CFG_FILEPATH $CFG_LOCAL_FILENAME"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      }
    },
    { // 使用结构安全调用记事本并阻塞等待
      "label": "open-notepad-and-wait",
      "type": "shell",
      "command": "notepad",
      "args": [
        "$CFG_LOCAL_FILENAME"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true
      }
    },
    { // 删除远程容器的独立微小任务
      "label": "docker-container-rm",
      "type": "shell",
      "command": "docker",
      "args": [
        "--context", "temp-remote-box",
        "rm", "$CFG_CONTAINER", "-f"
      ],
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    { // 删除上下文隧道的独立微小任务
      "label": "docker-context-rm",
      "type": "shell",
      "command": "docker",
      "args": [
        "context",
        "rm", "temp-remote-box", "-f"
      ],
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    { // 删除环境变量文件
        "label": "cleanup-env-file",
        "type": "shell",
        "command": "rm",
        "args": [
            "-f", "./.vscode/combined.tmp.env"
        ],
        "presentation": {
            "reveal": "silent",
            "panel": "shared"
        }
    },
    { // 总控制流流水线
      "label": "Remote Docker Build",
      "dependsOn": [
        "docker-context-create",
        "docker-context-init",
        "docker-build-execute",
        "pre-cleanup-container",
        "merge-env-files",
        "docker-container-create",
        "docker-container-cp",
        "open-notepad-and-wait",
        "docker-container-rm",
        "docker-context-rm",
        "cleanup-env-file"
      ],
      "dependsOrder": "sequence",
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true
      }
    }
  ],
  "inputs": [
    {
      "id": "project",
      "type": "promptString",
      "description": "请输入项目名",
      "default": "qyzjl"
    },
    {
      "id": "module",
      "type": "promptString",
      "description": "请输入需要扫描模块名",
      "default": "security"
    },
    {
      "id": "workdir",
      "type": "promptString",
      "description": "请输入工作目录",
      "default": "/home/storezhang"
    },
    {
      "id": "organization",
      "type": "promptString",
      "description": "请输入组织名称",
      "default": "sichuancredit"
    }
  ],
  "runOptions": {
    "onBuildErrors": "ignore"
  }
}
